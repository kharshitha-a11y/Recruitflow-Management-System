# =============================================================================
# RecruitFlow – Enterprise Environment Configuration Example
# Copy this file to .env and configure for your deployment environment.
# NEVER commit .env or secrets to version control.
# =============================================================================

# Server & Reverse Proxy Configuration
PORT=10000
PROXY_HOST=0.0.0.0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501

# PostgreSQL Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recruitflow
DB_USER=postgres
DB_PASSWORD=your_password_here

# Frontend & API Client Configuration
BACKEND_API_URL=http://localhost:8000
API_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:10000,http://127.0.0.1:10000,http://localhost:8501
